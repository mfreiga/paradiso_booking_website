# Copy this file to `.env` and fill in the values. (`.env` is gitignored.)

# Postgres connection string (matches docker-compose.yml for local dev)
DATABASE_URL="postgresql://paradiso:paradiso@localhost:5432/paradiso?schema=public"

# Shop timezone (IANA name)
SHOP_TIMEZONE="Europe/Berlin"

# Public site address — used for the manage/cancel and review links in emails.
# On Netlify, falls back to the automatic URL variable if left empty.
SITE_URL="http://localhost:3000"

# ── Auth & email (used from M2 onward) ──
# Generate with:  npx auth secret   (or:  openssl rand -base64 33)
AUTH_SECRET=""
# ── Email: set ONE of RESEND_API_KEY or SMTP_URL. Neither = emails are only logged. ──
# Option A, Resend (needs a domain you own, verified in Resend):
RESEND_API_KEY=""
# Option B, any SMTP mailbox, e.g. Gmail with an app password (no own domain needed):
#   SMTP_URL="smtps://yourname%40gmail.com:APP_PASSWORD@smtp.gmail.com:465"
#   (write @ in the username as %40; the app password has no spaces)
SMTP_URL=""
# Sender shown to customers. With Gmail this must be that Gmail address.
EMAIL_FROM="Hairstyling Paradiso <onboarding@resend.dev>"
# Where new-booking and cancellation alerts go (the owner's inbox). Comma-separated.
NOTIFY_EMAIL=""
# Day-before reminder emails: a long random string (e.g. `openssl rand -hex 32`).
# The hourly Netlify function netlify/functions/reminders.mts sends it to
# /api/cron/reminders. Without it, no reminders are sent.
CRON_SECRET=""
# Comma-separated list of emails allowed to access /admin
ADMIN_EMAILS=""
# Admin login password — use a long random one in production
ADMIN_PASSWORD=""
